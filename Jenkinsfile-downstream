properties(
    [
        parameters(
            [
                string(
                    name: 'build',
                    description: 'What is our build id?',
                )
            ]
        )
    ]
) // end of properties

node('node1') {
    checkout scm
    stage('Download') {
        copyArtifacts(projectName: 'pipeline1', selector: specific("${params.build}"));
        sh "docker load -i xitrin-nginx-${params.build}.img"
    }
    stage('Deploy') {
        sh "docker run --rm -d --name xitrin-nginx-${params.build} xitrin-nginx"
        sh "ip=\$(docker inspect xitrin-nginx-${params.build} | jq -r '.[0].NetworkSettings.Networks.bridge.IPAddress'); echo $ip > ip.txt"
    }
    stage('Test') {
        sh "ip=\$(cat ip.txt) curl \$ip"
    }
    stage('Clean') {
        sh "docker stop xitrin-nginx-${params.build}"
        sh "docker rmi xitrin-nginx"
        cleanWs()
    }
}