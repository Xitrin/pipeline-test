properties(
    [
        parameters(
            [
                string(
                    name: 'build',
                    description: 'What is our build id?',
                )
            ]
        )
    ]
) // end of properties

node('node1') {
    checkout scm
    stage('Download') {
        sh "curl -O http://jenkins:8080/job/pipeline1/${params.build}/artifact/xitrin-nginx-${params.build}.img "
        sh "docker load xitrin-nginx-${params.build}"
    }
    stage('Deploy') {
        sh "docker run --rm -d --name xitrin-nginx-${params.build} xitrin-nginx-${params.build};
            ip=\$(docker inspect xitrin-nginx-${params.build} | jq -r '.[0].NetworkSettings.Networks.bridge.IPAddress');
            echo $ip > ip.txt"
    }
    stage('Test') {
        sh "ip=\$(cat ip.txt) curl \$ip"
    }
    stage('Clean') {
        sh "docker stop xitrin-nginx-${params.build};
            docker rmi xitrin-nginx-${params.build}"
        cleanWs()
    }
}